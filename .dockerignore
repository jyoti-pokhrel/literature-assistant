playwright-report
test-results

# Secrets and local config
.env
.env.local
.env.*.local

# Build artifacts
dist
build
*.egg-info

# Docs / markdown — keep CLAUDE.md out of the image
*.md
docs

# OS junk
.DS_Store
Thumbs.db

# Large data file — uncomment if the runtime doesn't need the seeded dataset.
# data/research_gap_dataset.jsonl
